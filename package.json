{
  "name": "unitview-windows",
  "version": "5.2.0-c",
  "description": "UnitView Patient Management Dashboard - Windows Desktop Application",
  "main": "dist/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "cd renderer && npm run dev",
    "dev:main": "tsc -p tsconfig.main.json && electron dist/main.js",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "cd renderer && npm run build",
    "build:renderer:fast": "cd renderer && npm run build:no-check",
    "build:main": "tsc -p tsconfig.main.json",
    "build:all": "npm run build && electron-builder",
    "preview": "cd renderer && npm run preview",
    "electron": "electron dist/main.js",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "postinstall": "cd renderer && npm install",
    "test": "npx --yes tsx --test src/security/*.test.ts src/fhir/*.test.ts",
    "test:fresh": "git pull && npm install && cd renderer && npm install && cd .. && npm run build && npm run electron"
  },
  "keywords": [
    "healthcare",
    "patient-management",
    "hospital",
    "electron",
    "react"
  ],
  "author": "Linearthrone",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20",
    "baseline-browser-mapping": "^2.10.20",
    "concurrently": "^8.2.2",
    "electron": "^39.2.2",
    "electron-builder": "^26.8.1",
    "typescript": "^5"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.unitview.windows",
    "productName": "UnitView",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/dist/**/*",
      "renderer/package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
